# Server Port
PORT=5000

# Database URL (SQLite default shown, replace with Postgres in production)
DATABASE_URL="file:./dev.db"

# Secret Key for JWT Signing (Must be long and random in production)
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Environment ("development" | "production")
NODE_ENV="development"

# SMS OTP Provider Configuration (Twilio for Production)
# Required for real SMS delivery in production:
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
# Optional: Twilio Messaging Service SID (if using Messaging Service instead of a single number)
# TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# SMS Provider Toggle: "twilio" for live provider, "simulator" to force local dev simulation
SMS_PROVIDER="twilio"

# Dev Mode Helper:
# If "true" AND NODE_ENV is "development" AND Twilio credentials are NOT set, returns devOtp in API response for local testing.
# In "production", devOtp is NEVER returned regardless of this flag.
DEV_EXPOSE_OTP="false"
