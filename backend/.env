# Server Port
PORT=5000

# SQLite Database Location
DATABASE_URL="file:./dev.db"

# Secret Key for JWT Signing (Change in Production!)
JWT_SECRET="dev-secret-key-frientables-2026-change-in-production"
JWT_EXPIRES_IN="7d"

# Environment ("development" | "production")
NODE_ENV="development"

# SMS OTP Provider Configuration (Twilio for Production)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# TWILIO_MESSAGING_SERVICE_SID=""

# SMS Provider Toggle ("twilio" | "simulator")
SMS_PROVIDER="twilio"

# Dev Mode Helper: Expose generated OTP in API response for local testing ONLY when Twilio is unconfigured
DEV_EXPOSE_OTP="true"
